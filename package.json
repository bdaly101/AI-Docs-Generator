    "commander": "^14.0.2",
    "cosmiconfig": "^9.0.0",
    "ora": "^9.0.0",
    "simple-git": "^3.30.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsup": "^8.5.1",
